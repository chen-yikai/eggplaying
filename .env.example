# Copy to .env.local (git-ignored) and restart Expo.
# Demo only: EXPO_PUBLIC_ values are bundled into the app, so anyone with the app can read this key.
EXPO_PUBLIC_GEMINI_API_KEY=

# Used only by Drizzle Kit (npm run db:migrate). Never add the EXPO_PUBLIC_ prefix: it contains the database password.
# Supabase > Connect > Session pooler. URL-encode the password.
DATABASE_URL=
