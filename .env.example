# Copy to .env (git-ignored). docker compose and Expo both read it.

# Deployment: use long random values, for example from `openssl rand -hex 32`.
POSTGRES_PASSWORD=
JWT_SECRET=
WEB_PORT=8080

# Phones and local previews: the address of the deployed web container, for example http://192.168.1.20:8080
# The website itself calls its own address, so it does not need this.
EXPO_PUBLIC_API_URL=

# Demo only: EXPO_PUBLIC_ values are bundled into the app, so anyone with the app can read this key.
EXPO_PUBLIC_GEMINI_API_KEY=
