# Copy to .env on the deploy server, fill it in, then run: docker compose up -d --build
# .env is git-ignored. Never commit it.

# ---------- Required at deploy: docker compose refuses to start without these ----------

# Database password, used by the db and api containers. Generate with: openssl rand -hex 32
# Postgres only reads this when the db volume is first created. Changing it later will not
# change the real password, and the API will fail to connect.
POSTGRES_PASSWORD=

# Signs login tokens, at least 32 characters. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=

# ---------- Optional at deploy ----------

# Password for /dashboard, which shows all user emails. At least 12 characters: openssl rand -hex 16
# Left empty, the dashboard stays off.
DASHBOARD_PASSWORD=

# Gemini key for fresh questions. Left empty, games use their built-in questions.
# Only the API container sees it, so it never reaches the website or the app.
GEMINI_API_KEY=

# ---------- Not used by the deployment: only for phones and local Expo previews ----------

# Address of the deployed site, for example https://play.example.com
# The deployed website calls its own address and ignores this.
EXPO_PUBLIC_API_URL=
